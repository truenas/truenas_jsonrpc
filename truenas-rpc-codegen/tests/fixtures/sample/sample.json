{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "sample",
  "version": "1.0.0",
  "$comment": "Spec-first IDL for the Zig codegen (api-specs/gen.py -> zig/conformance/rpc_gen.zig). The login/ping/crash methods mirror the hand-written `audit` reference protocol so the A/B golden can run through the generated path; Demo/Inner exercise the emitter's type breadth (optional, default, array, enum, nested $ref, secret).",
  "$defs": {
    "LoginArgs": {
      "type": "object",
      "properties": {
        "user": { "type": "string" },
        "password": { "type": "string", "secret": true }
      },
      "required": ["user", "password"],
      "additionalProperties": false
    },
    "LoginResult": {
      "type": "object",
      "properties": {
        "token": { "type": "string", "secret": true },
        "ok": { "type": "boolean" }
      },
      "required": ["token", "ok"],
      "additionalProperties": false
    },
    "PingArgs": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "PingResult": {
      "type": "object",
      "properties": { "pong": { "type": "boolean" } },
      "required": ["pong"],
      "additionalProperties": false
    },
    "CrashArgs": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "Inner": {
      "type": "object",
      "properties": { "x": { "type": "integer" } },
      "required": ["x"],
      "additionalProperties": false
    },
    "Demo": {
      "type": "object",
      "$comment": "Not registered as a method; exercises the emitter's type mapping for a round-trip unit test.",
      "properties": {
        "name": { "type": "string" },
        "count": { "type": "integer", "default": 0 },
        "ratio": { "type": "number", "default": 1.5 },
        "note": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "color": { "type": "string", "enum": ["red", "green", "blue"] },
        "inner": { "$ref": "#/$defs/Inner" },
        "api_key": { "type": "string", "secret": true }
      },
      "required": ["name", "color", "inner", "api_key"],
      "additionalProperties": false
    },
    "QueryArgs": {
      "type": "object",
      "$comment": "Base accepts for the filterable x.query method; augmented at runtime with query-filters/query-options.",
      "properties": {},
      "additionalProperties": false
    },
    "Entry": {
      "type": "object",
      "$comment": "Element type of the filterable x.query method (flat scalars + an optional, for the filter ops + null guards).",
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" },
        "ratio": { "type": "number" },
        "active": { "type": "boolean" },
        "note": { "type": "string" }
      },
      "required": ["id", "name", "ratio", "active"],
      "additionalProperties": false
    },
    "XferArgs": {
      "type": "object",
      "$comment": "Params for the raw-fd transfer methods (x.download / x.upload).",
      "properties": { "n": { "type": "integer" } },
      "required": ["n"],
      "additionalProperties": false
    },
    "DownloadReady": {
      "type": "object",
      "$comment": "Typed $/transferReady interim for x.download — the byte count the server will send.",
      "properties": { "size": { "type": "integer" } },
      "required": ["size"],
      "additionalProperties": false
    },
    "DownloadDone": {
      "type": "object",
      "properties": { "sent": { "type": "integer" } },
      "required": ["sent"],
      "additionalProperties": false
    },
    "UploadDone": {
      "type": "object",
      "properties": { "received": { "type": "integer" } },
      "required": ["received"],
      "additionalProperties": false
    }
  },
  "methods": {
    "login": {
      "summary": "Authenticate a user; returns a session token.",
      "params": { "$ref": "#/$defs/LoginArgs" },
      "result": { "$ref": "#/$defs/LoginResult" },
      "handler": "login",
      "audit": true,
      "auditMessage": "user login"
    },
    "ping": {
      "summary": "Liveness probe.",
      "params": { "$ref": "#/$defs/PingArgs" },
      "result": { "$ref": "#/$defs/PingResult" },
      "handler": "ping",
      "xdr": true,
      "xdr_id": 1001
    },
    "crash": {
      "summary": "Always raises (exercises the error-audit path).",
      "params": { "$ref": "#/$defs/CrashArgs" },
      "result": { "$ref": "#/$defs/PingResult" },
      "handler": "crash",
      "audit": true,
      "auditMessage": "crash op"
    },
    "x.query": {
      "summary": "Filterable query over a collection of entries.",
      "params": { "$ref": "#/$defs/QueryArgs" },
      "filterable": true,
      "entry": { "$ref": "#/$defs/Entry" },
      "handler": "query"
    },
    "x.download": {
      "summary": "Raw-fd download (server produces the stream) with a typed $/transferReady interim.",
      "params": { "$ref": "#/$defs/XferArgs" },
      "result": { "$ref": "#/$defs/DownloadDone" },
      "handler": "download",
      "transfer": { "direction": "download", "ready": { "$ref": "#/$defs/DownloadReady" } }
    },
    "x.upload": {
      "summary": "Raw-fd upload (client produces the stream) with a free-form $/transferReady interim.",
      "params": { "$ref": "#/$defs/XferArgs" },
      "result": { "$ref": "#/$defs/UploadDone" },
      "handler": "upload",
      "transfer": { "direction": "upload" }
    }
  }
}
